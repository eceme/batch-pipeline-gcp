# Copy to .env (git-ignored) and set your own values.
GITHUB_TOKEN=github_pat_your_token
GCP_PROJECT=your-gcp-project-id
# terraform -chdir=terraform output -raw raw_bucket_name
GCS_BUCKET=your-gcp-project-id-raw
# terraform -chdir=terraform output -raw pipeline_service_account_email; leave empty to use plain ADC.
IMPERSONATE_SA=pipeline-sa@your-gcp-project-id.iam.gserviceaccount.com
